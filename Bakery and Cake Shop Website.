{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #fff8f0;
    color: #4b2929;
}

header {
    background-color: #7b263a;
    color: white;
    text-align: center;
    padding: 25px;
}

nav {
    background-color: #f4b6a6;
    padding: 15px;
    text-align: center;
}

nav a {
    color: #4b2020;
    text-decoration: none;
    margin: 12px;
    font-weight: bold;
}

nav a:hover {
    color: white;
}

.banner {
    text-align: center;
    padding: 65px 20px;
    background: linear-gradient(#ffe0c2, #ffc6b5);
}

.banner h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.banner p {
    margin-bottom: 20px;
}

.btn {
    display: inline-block;
    background-color: #9b3048;
    color: white;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 6px;
    margin: 10px 0;
}

.btn:hover {
    background-color: #57202d;
}

.products {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    padding: 30px 15px;
}

.card {
    background-color: white;
    width: 250px;
    padding: 15px;
    text-align: center;
    border-radius: 12px;
    box-shadow: 0 3px 10px #d8bdb5;
}

.card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: 8px;
}

.card h3 {
    margin: 12px;
    color: #8b263e;
}

.card p {
    margin: 10px;
}

.card h4 {
    color: green;
    font-size: 20px;
}

.offer {
    background-color: #f8d6a5;
    text-align: center;
    padding: 30px;
}

footer {
    background-color: #7b263a;
    color: white;
    text-align: center;
    padding: 20px;
}

footer a {
    color: white;
}

@media (max-width: 600px) {
    nav a {
        display: inline-block;
        margin: 6px;
    }

    .card {
        width: 90%;
    }
}

